[ .location    # The currently loaded location: { .name .description .start .grid .features .exits }
  .party       # Array of party member records: { .name .hp .max-hp }
  ] VARIABLES

: TITLE   "Forthic Dungeon";
: WIDTH   800;
: HEIGHT   600;
: MESSAGE-HEIGHT   130;
: STAT-BAR-HEIGHT  64;
: FONT   "/System/Library/Fonts/SFNSMono.ttf";
: FONT-SIZE   16;
: LOCATION   "modules/raylib/repl/locations/goblin-warren/location.forthic";

: INITIAL-PARTY
    [ { .name "Thorin" .hp 24 .max-hp 24 }
      { .name "Elara"  .hp 16 .max-hp 18 }
      { .name "Grimm"  .hp 5  .max-hp 20 }
      { .name "Vex"    .hp 12 .max-hp 12 }
    ]
;

: RESET-GAME-STATE
    .location @ .start JQ@ .start-pos !
    { .x .start-pos @ .x JQ@
      .y .start-pos @ .y JQ@
      .facing .start-pos @ .facing JQ@
      .grid .location @ .grid JQ@
    } movement.RESET
    INITIAL-PARTY .party !
;

# history module's hook: how history.RESTORE-TO gets back to a clean state before replaying.
: ON-HISTORY-RESET   RESET-GAME-STATE log.CLEAR;

: ON-INITIALIZE-APP
    { .width WIDTH .height HEIGHT .title TITLE } raylib.INIT-WINDOW
    60 raylib.SET-TARGET-FPS
    FONT FONT-SIZE raylib.LOAD-FONT
    LOCATION LOAD-OBJECT .location !
    { .x 0 .y 470 .width WIDTH .height MESSAGE-HEIGHT .visible-count 5 } message-log.INITIALIZE
    { .x 0 .y 0 .width WIDTH .height STAT-BAR-HEIGHT } status-bar.INITIALIZE
    "dungeon_history.db" sqlite.OPEN
    history.INITIALIZE
;

: CAMERA-X   movement.PLAYER-X 0.5 +;
: CAMERA-Z   movement.PLAYER-Y 0.5 +;
: TARGET-X   CAMERA-X movement.FACING-DX +;
: TARGET-Z   CAMERA-Z movement.FACING-DY +;

# The view corridor-view.DRAW needs to raycast from the player's current
# position/facing, built fresh each frame so corridor-view holds no state
# of its own about the player or the location.
: CORRIDOR-VIEW
    { .grid .location @ .grid JQ@
      .x movement.PLAYER-X .y movement.PLAYER-Y
      .facing-dx movement.FACING-DX .facing-dy movement.FACING-DY
      .left-dx movement.LEFT-DX .left-dy movement.LEFT-DY
    }
;

# Party status bar: a strip across the top (the message log owns the bottom), name + HP text + a color-coded HP bar per member
# ( party-member -- status-item )
: PARTY-STATUS-ITEM   ( .status-member ! )
    { .ratio .status-member @ .hp JQ@ .status-member @ .max-hp JQ@ /
      .label [ .status-member @ .name JQ@ " " .status-member @ .hp JQ@ >STR "/" .status-member @ .max-hp JQ@ >STR ] CONCAT }
;

: DRAW-PARTY-BAR   .party @ "PARTY-STATUS-ITEM" MAP status-bar.DRAW;

# Extend with dungeon-specific key bindings (e.g. inventory, spells) via
# movement.ON-KEY, alongside movement's own WASD/arrow bindings.
: HANDLE-INPUT   movement.HANDLE-INPUT;

: DRAW-FRAME
    raylib.BEGIN-DRAWING
       { .r 10 .g 10 .b 20 .a 255 } raylib.CLEAR-BACKGROUND
       # 3D mode
       { .position { .x CAMERA-X .y 0.5 .z CAMERA-Z } .target { .x TARGET-X .y 0.5 .z TARGET-Z } .fovy 60 } raylib.BEGIN-MODE-3D
          { .slices 20 .spacing 1 } raylib.DRAW-GRID
          CORRIDOR-VIEW corridor-view.DRAW
       raylib.END-MODE-3D
       # Draw overlays
       DRAW-PARTY-BAR
       message-log.DRAW
    raylib.END-DRAWING
;

: ON-DRAW-FRAME   HANDLE-INPUT DRAW-FRAME;
